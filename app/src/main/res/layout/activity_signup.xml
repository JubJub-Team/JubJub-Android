<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="10dp"
    android:background="#F2F2F2"
    tools:context=".ui.auth.Hilt_SignupActivity"
    tools:ignore="HardcodedText,SmallSp,ContentDescription,VisualLintOverlap,TouchTargetSize">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 로고 -->
            <ImageView
                android:id="@+id/ic_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo"
                app:layout_constraintEnd_toStartOf="@+id/ic_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 프로필 이미지 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ic_profile"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="33dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/CircleImage" />

            <FrameLayout
                android:id="@+id/profile_image_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-31dp"
                android:layout_marginStart="68dp"
                app:layout_constraintTop_toBottomOf="@id/ic_profile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/img_ellipse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_ellipse"
                    android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/ic_camera"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="@null"
                    android:elevation="8dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"/>
            </FrameLayout>

            <!-- 비밀번호 -->
            <TextView
                android:id="@+id/tv_pw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="비밀번호*"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/til_pw"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_pw" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_pw"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/profile_image_wrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_pw"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:hint="영문, 숫자 조합 8~16자"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_pw_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#E53935"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_pw"
                app:layout_constraintStart_toStartOf="@id/til_pw" />

            <!-- 비밀번호 확인 -->
            <TextView
                android:id="@+id/tv_pwcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="비밀번호 확인*"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/til_pw_check"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_pw_check" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_pw_check"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_pw"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_pwcheck"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="비밀번호 다시 입력"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_pwcheck_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#E53935"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_pw_check"
                app:layout_constraintStart_toStartOf="@id/til_pw_check" />

            <!-- 학교(필수) -->
            <TextView
                android:id="@+id/tv_school"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="학교*"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/til_school"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_school" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_school"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_pw_check"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_school"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="서울여자대학교"
                    android:padding="0dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 닉네임 -->
            <TextView
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="닉네임*"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/til_nickname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_nickname" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_nickname"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_school"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_nickname"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="슈니"
                    android:padding="0dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_nickname_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#E53935"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_nickname"
                app:layout_constraintStart_toStartOf="@id/til_nickname" />

            <!-- 이메일 -->
            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="이메일*"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_nickname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_email"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="school@email.ac.kr"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_email_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#E53935"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="@id/til_email" />

            <!-- 가입/취소 버튼: 마지막 입력(이메일) 아래로 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="30dp"
                android:text="가입"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#20CD7C"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.3"
                android:contentDescription="@null"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="30dp"
                android:text="취소"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#BDBDBD"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toEndOf="@id/btn_signup"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.1"
                android:contentDescription="@null"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
