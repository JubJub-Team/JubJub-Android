<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="10dp"
    android:background="#F2F2F2"
    tools:context=".SignupActivity">

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 상단 프로필 아이콘 -->
            <ImageView
                android:id="@+id/ic_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:src="@drawable/ic_profile"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 원 + 카메라 묶음 -->
            <FrameLayout
                android:id="@+id/profile_image_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ic_profile" />

            <ImageView
                android:id="@+id/ic_camera"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_margin="6dp"
                android:elevation="8dp"
                android:src="@drawable/ic_camera"
                tools:layout_editor_absoluteX="223dp"
                tools:layout_editor_absoluteY="100dp" />

            <ImageView
                android:id="@+id/ic_ellipse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_ellipse"
                tools:layout_editor_absoluteX="218dp"
                tools:layout_editor_absoluteY="95dp" />

            <!-- 아이디 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_id"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintTop_toBottomOf="@id/profile_image_wrapper"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_id"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="예) Swu0520"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_idcheck"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"

                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"

                app:layout_constraintBottom_toBottomOf="@id/til_id"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/til_id"
                app:layout_constraintTop_toTopOf="@id/til_id" />

            <!-- 아이디 중복 확인 안내 메시지 -->
            <TextView
                android:id="@+id/tv_id_check_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF0000"
                android:visibility="gone"

                app:layout_constraintTop_toBottomOf="@id/til_id"
                app:layout_constraintStart_toStartOf="@id/til_id"
                android:layout_marginTop="4dp" />

            <!-- 비밀번호 -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_pw"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/til_id"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_pw"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="영문, 숫자 조합 8~16자"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 확인 -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_pw_check"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/til_pw"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_pwcheck"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="영문, 숫자 조합 8~16자"
                    android:inputType="textPassword"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 이름 -->

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/til_pw_check"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_name"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="김슈니"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 학교 -->

            <TextView
                android:id="@+id/tv_school"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="학교*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_school"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_school"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="아이디*"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@id/til_id"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_id"
                app:layout_constraintVertical_bias="0.333" />

            <TextView
                android:id="@+id/tv_pw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="비밀번호*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_pw"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_pw"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_pwcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="비밀번호 확인*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_pw_check"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_pw_check"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="이름*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_name"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="닉네임*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_nickname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_nickname"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="이메일*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_email"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="전화번호*"
                android:textSize="11sp"
                app:hintTextColor="#BDBDBD"
                app:layout_constraintBottom_toBottomOf="@id/til_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_phone"
                app:layout_constraintVertical_bias="0.388" />

            <TextView
                android:id="@+id/tv_birth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="생년월일*"

                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@id/til_birth"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_birth"
                app:layout_constraintVertical_bias="0.388" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_school"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/til_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_school"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="서울여자대학교"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 닉네임 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_nickname"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/til_school"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_nickname"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="슈니"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nicknamecheck"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"

                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"

                app:layout_constraintBottom_toBottomOf="@id/til_nickname"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/til_nickname"
                app:layout_constraintTop_toTopOf="@id/til_nickname" />

            <!-- 닉네임 중복 확인 안내 메시지 -->
            <TextView
                android:id="@+id/tv_nickname_check_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF0000"
                android:visibility="gone"

                app:layout_constraintTop_toBottomOf="@id/til_nickname"
                app:layout_constraintStart_toStartOf="@id/til_nickname"
                android:layout_marginTop="4dp" />

            <!-- 이메일 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"

                app:layout_constraintTop_toBottomOf="@id/til_nickname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_email"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="swu0520@ac.kr"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_emailcheck"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"

                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"

                app:layout_constraintBottom_toBottomOf="@id/til_email"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/til_email"
                app:layout_constraintTop_toTopOf="@id/til_email" />

            <!-- 이메일 중복 확인 안내 메시지 -->
            <TextView
                android:id="@+id/tv_email_check_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF0000"
                android:visibility="gone"

                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="@id/til_email"
                android:layout_marginTop="4dp" />

            <!-- 전화번호 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/til_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_phone"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="010-0000-0000"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:textSize="9sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_phonecheck"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"

                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"

                app:layout_constraintBottom_toBottomOf="@id/til_phone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@id/til_phone"
                app:layout_constraintTop_toTopOf="@id/til_phone" />

            <!-- 전화번호 중복 확인 안내 메시지 -->
            <TextView
                android:id="@+id/tv_phone_check_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#FF0000"
                android:visibility="gone"

                app:layout_constraintTop_toBottomOf="@id/til_phone"
                app:layout_constraintStart_toStartOf="@id/til_phone"
                android:layout_marginTop="4dp" />

            <!-- 생년월일 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_birth"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"

                app:layout_constraintTop_toBottomOf="@id/til_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_birth"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="YYYY.MM.DD"
                    android:inputType="date"
                    android:padding="12dp"
                    android:textSize="9sp"
                    app:hintTextColor="#BDBDBD" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 가입 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="20dp"
                android:text="가입"
                android:textColor="#FFFFFF"
                android:textSize="10sp"

                android:textStyle="bold"
                app:backgroundTint="#20CD7C"

                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/til_birth" />

            <!-- 취소 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="20dp"
                android:text="취소"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"

                app:backgroundTint="#BDBDBD"
                app:cornerRadius="8dp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.1"
                app:layout_constraintStart_toEndOf="@id/btn_signup"
                app:layout_constraintTop_toBottomOf="@id/til_birth" />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_logo"
                tools:layout_editor_absoluteX="8dp"
                tools:layout_editor_absoluteY="30dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>