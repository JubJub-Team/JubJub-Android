<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_lost_found_post_detail_image"
        android:layout_width="match_parent"
        android:layout_height="373dp"
        tools:src="@tools:sample/backgrounds/scenic"
        android:contentDescription="@string/cd_detail_img" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="31dp"
        android:paddingEnd="31dp">

        <TextView
            android:id="@+id/tv_lost_found_post_detail_id_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="11dp"
            tools:text="글쓴 사람 아이디•01/17 1:05" />

        <TextView
            android:id="@+id/tv_lost_found_post_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="24dp"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="게시글 제목" />

        <!-- 발견 장소 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tv_lost_found_post_detail_label_found_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_found_place"
                android:textColor="#616161"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_lost_found_post_detail_found_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="#000000"
                android:textSize="12sp"
                tools:text="서울여대 과학관" />
        </LinearLayout>

        <!-- 상세 장소 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tv_lost_found_post_detail_label_detail_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_detail_place"
                android:textColor="#616161"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_lost_found_post_detail_detail_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="#000000"
                android:textSize="12sp"
                tools:text="제 2과-302" />
        </LinearLayout>

        <!-- 발견 일시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tv_lost_found_post_detail_label_found_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_found_date"
                android:textColor="#616161"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_lost_found_post_detail_found_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="#000000"
                android:textSize="12sp"
                tools:text="01/17 12:35" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_lost_found_post_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="none"
            android:paddingTop="26dp"
            android:paddingBottom="26dp"
            tools:text="게시글 내용" />

        <!-- 위탁 장소 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="27dp">

            <TextView
                android:id="@+id/tv_lost_found_post_detail_label_entrusted_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_entrusted_place"
                android:textColor="#616161"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_lost_found_post_detail_entrusted_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:textColor="#000000"
                android:textSize="12sp"
                tools:text="누리관 2층 학생지원실" />
        </LinearLayout>

        <!-- 위 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#616161" />

        <!-- 아이콘 + 댓글 수 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="5dp">

            <ImageView
                android:id="@+id/iv_lost_found_post_detail_commentIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ic_comment_24"
                app:tint="#616161"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_lost_found_post_detail_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#616161"
                android:textSize="13sp"
                tools:text="댓글 2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#616161" />

    </LinearLayout>
</LinearLayout>
