                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/img_thirdboard_profile"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="11dp"
                            android:contentDescription="@null"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:src="@drawable/profile"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/img_thirdboard_body"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="35dp"
                            android:contentDescription="@null"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <TextView
                            android:id="@+id/user_name_third"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_marginTop="11dp"
                            android:gravity="center"
                            android:text=""
                            android:textSize="8sp"
                            app:layout_constraintStart_toEndOf="@+id/img_thirdboard_body"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="닉네임" />

                        <TextView
                            android:id="@+id/tv_third_board_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="35dp"
                            android:text=""
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@+id/img_thirdboard_body"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="제목 미리보기" />

                        <TextView
                            android:id="@+id/tv_third_board_body_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="3dp"
                            android:text=""
                            android:textColor="#B3B3B3"
                            android:textSize="11sp"
                            app:layout_constraintStart_toEndOf="@+id/img_thirdboard_body"
                            app:layout_constraintTop_toBottomOf="@+id/tv_third_board_title"
                            tools:text="본문 미리보기" />

                        <TextView
                            android:id="@+id/tv_third_board_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="172dp"
                            android:layout_marginBottom="68dp"
                            android:text=""
                            android:textSize="8sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/img_thirdboard_body"
                            tools:text="01/16  12:19" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--게시물 4-->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fourthboard"
                    android:layout_width="300dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="2dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/thirdboard"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/img_fourthboard_profile"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="11dp"
                            android:contentDescription="@null"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:src="@drawable/profile"
                            app:layout_constraintStart_toStartOf="parent"
