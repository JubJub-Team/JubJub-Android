                            android:layout_height="50dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="35dp"
                            android:contentDescription="@null"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <TextView
                            android:id="@+id/user_name_second"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_marginTop="11dp"
                            android:gravity="center"
                            android:text=""
                            android:textSize="8sp"
                            app:layout_constraintStart_toEndOf="@+id/img_secondboard_profile"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="닉네임" />

                        <TextView
                            android:id="@+id/tv_second_board_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="35dp"
                            android:text=""
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@+id/img_secondboard_body"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="제목 미리보기" />

                        <TextView
                            android:id="@+id/tv_second_board_body_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="3dp"
                            android:text=""
                            android:textColor="#B3B3B3"
                            android:textSize="11sp"
                            app:layout_constraintStart_toEndOf="@+id/img_secondboard_body"
                            app:layout_constraintTop_toBottomOf="@+id/tv_second_board_title"
                            tools:text="본문 미리보기" />

                        <TextView
                            android:id="@+id/tv_second_board_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="172dp"
                            android:layout_marginBottom="68dp"
                            android:text=""
                            android:textSize="8sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/img_secondboard_body"
                            tools:text="01/16  12:19" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    <!--분실물게시판-->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lost_found_card"
            android:layout_width="318dp"
            android:layout_height="265dp"
            android:layout_marginStart="45dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="45dp"
            android:layout_marginBottom="216dp"
            app:cardBackgroundColor="@color/search"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/share_card"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

