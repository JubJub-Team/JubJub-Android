                        <TextView
                            android:id="@+id/user_name_fourth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_marginTop="11dp"
                            android:gravity="center"
                            android:text=""
                            android:textSize="8sp"
                            app:layout_constraintStart_toEndOf="@+id/img_fourthboard_profile"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="닉네임" />

                        <TextView
                            android:id="@+id/tv_fourth_board_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="35dp"
                            android:text=""
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@+id/img_fourthboard_body"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="제목 미리보기" />

                        <TextView
                            android:id="@+id/tv_fourth_board_body_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="3dp"
                            android:text=""
                            android:textColor="#B3B3B3"
                            android:textSize="11sp"
                            app:layout_constraintStart_toEndOf="@+id/img_fourthboard_body"
                            app:layout_constraintTop_toBottomOf="@+id/tv_fourth_board_title"
                            tools:text="본문 미리보기" />

                        <TextView
                            android:id="@+id/tv_fourth_board_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="172dp"
                            android:layout_marginBottom="68dp"
                            android:text=""
                            android:textSize="8sp"
                            app:layout_constraintBottom_toBottomOf="parent"
