<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_profile_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="10dp"
    android:background="#F2F2F2"
    tools:context="ui.mypage.ProfileFragment"
    tools:ignore="HardcodedText,SmallSp,ContentDescription,VisualLintOverlap,TouchTargetSize">

    <ScrollView
        android:id="@+id/sv_profile_edit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_profile_edit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 로고 -->
            <ImageView
                android:id="@+id/iv_profile_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="91dp"
                android:layout_marginBottom="112dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_logo"
                app:layout_constraintBottom_toTopOf="@+id/tv_profile_username_label"
                app:layout_constraintEnd_toStartOf="@+id/iv_profile_header_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 프로필 아이콘(상단 장식) -->
            <ImageView
                android:id="@+id/iv_profile_header_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="33dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile"
                app:layout_constraintBottom_toTopOf="@+id/til_profile_username"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 프로필 이미지 + 카메라 -->
            <FrameLayout
                android:id="@+id/fl_profile_image_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-31dp"
                android:layout_marginStart="68dp"
                app:layout_constraintTop_toBottomOf="@id/iv_profile_header_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_profile_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ellipse"/>

                <ImageView
                    android:id="@+id/iv_profile_camera"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="6dp"
                    android:contentDescription="@null"
                    android:elevation="8dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_camera"/>
            </FrameLayout>

            <!-- 아이디 -->
            <TextView
                android:id="@+id/tv_profile_username_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="아이디"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_username"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_username"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_username"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/iv_profile_header_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_username"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="예) Swu0520"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 아이디 안내 메시지 -->
            <TextView
                android:id="@+id/tv_profile_username_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_profile_username"
                app:layout_constraintStart_toStartOf="@id/til_profile_username" />

            <!-- 아이디 중복 확인 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_username_check"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:contentDescription="@null"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_username"
                app:layout_constraintStart_toEndOf="@id/til_profile_username"
                app:layout_constraintTop_toTopOf="@id/til_profile_username" />

            <!-- 비밀번호 -->
            <TextView
                android:id="@+id/tv_profile_password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="비밀번호"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_password"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_password"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_password"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_username"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_password"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="영문, 숫자 조합 8~16자"
                    android:padding="0dp"
                    android:textSize="9sp"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 안내 메시지 -->
            <TextView
                android:id="@+id/tv_profile_password_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_profile_password"
                app:layout_constraintStart_toStartOf="@id/til_profile_password" />

            <!-- 비밀번호 확인 -->
            <TextView
                android:id="@+id/tv_profile_password_confirm_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="비밀번호 확인"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_password_confirm"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_password_confirm"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_password_confirm"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_password"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_password_confirm"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="영문, 숫자 조합 8~16자"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 비밀번호 확인 안내 메시지 -->
            <TextView
                android:id="@+id/tv_profile_password_confirm_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_profile_password_confirm"
                app:layout_constraintStart_toStartOf="@id/til_profile_password_confirm" />

            <!-- 이름 -->
            <TextView
                android:id="@+id/tv_profile_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="이름"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_name"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_name"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_name"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_password_confirm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_name"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="김슈니"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 학교 -->
            <TextView
                android:id="@+id/tv_profile_school_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="학교"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_school"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_school"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_school"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_school"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="서울여자대학교"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 닉네임 -->
            <TextView
                android:id="@+id/tv_profile_nickname_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="닉네임"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_nickname"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_nickname"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_nickname"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_school"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_nickname"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="슈니"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 닉네임 안내 메시지 -->
            <TextView
                android:id="@+id/tv_profile_nickname_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_profile_nickname"
                app:layout_constraintStart_toStartOf="@id/til_profile_nickname" />

            <!-- 닉네임 중복 확인 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_nickname_check"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:contentDescription="@null"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_nickname"
                app:layout_constraintStart_toEndOf="@id/til_profile_nickname"
                app:layout_constraintTop_toTopOf="@id/til_profile_nickname" />

            <!-- 이메일 -->
            <TextView
                android:id="@+id/tv_profile_email_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="이메일"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_email"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_email"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_email"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_nickname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_email"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="swu0520@ac.kr"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 이메일 안내 메시지 -->
            <TextView
                android:id="@+id/tv_profile_email_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_profile_email"
                app:layout_constraintStart_toStartOf="@id/til_profile_email" />

            <!-- 이메일 중복 확인 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_email_check"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:contentDescription="@null"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_email"
                app:layout_constraintStart_toEndOf="@id/til_profile_email"
                app:layout_constraintTop_toTopOf="@id/til_profile_email" />

            <!-- 전화번호 -->
            <TextView
                android:id="@+id/tv_profile_phone_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="전화번호"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_phone"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_phone"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_phone"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_phone"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="010-0000-0000"
                    android:inputType="phone"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 전화번호 안내 메시지 -->
            <TextView
                android:id="@+id/tv_profile_phone_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/til_profile_phone"
                app:layout_constraintStart_toStartOf="@id/til_profile_phone" />

            <!-- 전화번호 중복 확인 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_phone_check"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:contentDescription="@null"
                android:text="중복 확인"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#20CD7C"
                app:cornerRadius="6dp"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_phone"
                app:layout_constraintStart_toEndOf="@id/til_profile_phone"
                app:layout_constraintTop_toTopOf="@id/til_profile_phone" />

            <!-- 생년월일 -->
            <TextView
                android:id="@+id/tv_profile_birth_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="생년월일"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/til_profile_birth"
                app:layout_constraintBottom_toBottomOf="@id/til_profile_birth"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_profile_birth"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/til_profile_phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.45">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profile_birth"
                    android:layout_width="190dp"
                    android:layout_height="28dp"
                    android:hint="YYYY.MM.DD"
                    android:inputType="date"
                    android:padding="0dp"
                    android:textSize="9sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 저장/취소 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_save"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="30dp"
                android:text="저장"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:contentDescription="@null"
                app:backgroundTint="#20CD7C"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/til_profile_birth"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_cancel"
                android:layout_width="88dp"
                android:layout_height="35dp"
                android:layout_marginTop="30dp"
                android:contentDescription="@null"
                android:text="취소"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#BDBDBD"
                app:cornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.1"
                app:layout_constraintStart_toEndOf="@id/btn_profile_save"
                app:layout_constraintTop_toBottomOf="@id/til_profile_birth" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
